<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 overflow-y-auto p-4 md:p-8">

    <% if (viewMode === 'list') { %>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Contact Messages</h1>
    <div class="flex items-center gap-4 text-sm text-gray-500 mb-6">
        <span class="flex items-center gap-1.5">
            <i data-lucide="mail" class="w-4 h-4"></i>
            <%= unreadCount %> unread
        </span>
        <span>•</span>
        <span><%= messages ? messages.length : 0 %> total</span>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <div class="space-y-4">
        <% if (messages && messages.length > 0) { %>
        <% messages.forEach((message) => { %>
        <a href="/messages/<%= message.id %>"
            class="block bg-white p-5 rounded-xl border <%= message.status === 'unread' ? 'border-blue-300 bg-blue-50/30' : 'border-gray-200' %> hover:shadow-sm hover:border-gray-300 transition-all">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-1 mb-2">
                <h2 class="font-semibold text-gray-900">
                    <%= message.name %> <span class="text-gray-400 font-normal">— <%= message.email %></span>
                    <% if (message.status === 'unread') { %>
                    <span
                        class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        New
                    </span>
                    <% } %>
                </h2>
                <span class="text-xs text-gray-400"><%= new Date(message.createdAt).toLocaleString() %></span>
            </div>
            <p class="text-sm text-gray-600 line-clamp-1">
                <%= message.message.substring(0, 150) %>...
            </p>
        </a>
        <% }); %>
        <% } else { %>
        <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
            <div class="flex justify-center mb-4">
                <i data-lucide="inbox" class="h-16 w-16 text-gray-300"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-600">No messages yet</h3>
            <p class="text-sm text-gray-400 mt-1">Messages from your readers will appear here</p>
        </div>
        <% } %>
    </div>

    <% } else if (viewMode === 'detail') { %>

    <!-- Detail View -->
    <a href="/messages"
        class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 mb-6 transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Messages
    </a>

    <!-- Flash Messages -->
    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-xl p-6 md:p-8">
            <div class="border-b border-gray-100 pb-4 mb-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-1">
                    <h2 class="text-lg font-bold text-gray-900">
                        <%= message.name %> <span class="text-sm text-gray-500 font-normal">—
                            <%= message.email %></span>
                    </h2>
                    <span class="text-sm text-gray-400"><%= new Date(message.createdAt).toLocaleString() %></span>
                </div>
                <% if (message.subject) { %>
                <p class="text-sm text-gray-600 font-medium mt-1">Subject: <%= message.subject %></p>
                <% } %>
                <div class="flex items-center gap-2 mt-2">
                    <span
                        class="text-xs font-medium px-2 py-1 rounded-full <%= message.status === 'unread' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
                        <%= message.status === 'unread' ? 'Unread' : 'Read' %>
                    </span>
                </div>
            </div>

            <div class="text-gray-700 space-y-4 text-sm md:text-base leading-relaxed">
                <%= message.message.split('\n').map(line => `<p>${line}</p>`).join('') %>
            </div>

            <div
                class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between border-t border-gray-100 mt-8 pt-4 gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <form action="/messages/toggle-status/<%= message.id %>" method="POST" class="inline">
                        <button type="submit"
                            class="inline-flex items-center justify-center gap-2 border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                            <i data-lucide="mail-<%= message.status === 'unread' ? 'open' : '' %>" class="w-4 h-4"></i>
                            Mark as <%= message.status === 'unread' ? 'read' : 'unread' %>
                        </button>
                    </form>
                    <a href="mailto:<%= message.email %>"
                        class="inline-flex items-center justify-center gap-2 border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        <i data-lucide="reply" class="w-4 h-4"></i> Reply by email
                    </a>
                </div>

                <form action="/messages/delete/<%= message.id %>" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this message?');">
                    <button type="submit"
                        class="inline-flex items-center justify-center gap-2 text-red-600 hover:bg-red-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors w-full sm:w-auto">
                        <i data-lucide="trash-2" class="w-4 h-4"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>

    <% } %>
</main>

</div>
<script>
    lucide.createIcons();

    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() { sidebar.classList.remove('hidden'); sidebar.classList.add('flex'); overlay.classList.remove('hidden'); }
    function closeMenu() { sidebar.classList.add('hidden'); sidebar.classList.remove('flex'); overlay.classList.add('hidden'); }

    menuToggle.addEventListener('click', openMenu);
    menuClose.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden'); sidebar.classList.add('flex'); overlay.classList.add('hidden');
        } else { closeMenu(); }
    });
</script>
</body>

</html>