<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nora Hale Books — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#F8FAFC] text-[#0F172A] font-sans antialiased h-screen flex flex-col overflow-hidden">

  <header class="bg-white border-b border-gray-200 px-4 md:px-6 py-4 flex items-center justify-between shrink-0 z-20">
    <div class="flex items-center gap-3">
      <button id="menu-toggle" class="p-1.5 text-gray-600 hover:bg-gray-100 rounded-md md:hidden focus:outline-none">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
      
      <i data-lucide="book-open" class="w-5 h-5 text-gray-500"></i>
      <span class="text-sm font-medium text-gray-700">Nora Hale Books — Admin</span>
    </div>
  </header>

  <div class="flex flex-1 relative overflow-hidden">
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-30 hidden transition-opacity duration-300"></div>