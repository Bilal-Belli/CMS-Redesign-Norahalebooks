<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<!-- Quill.js CSS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .ql-container {
        font-size: 14px;
        min-height: 100px;
    }

    .ql-editor {
        min-height: 100px;
    }

    .ql-editor p {
        margin-bottom: 0.75rem;
    }

    .ql-editor ul,
    .ql-editor ol {
        padding-left: 1.5rem;
        margin: 0.5rem 0;
    }

    .quill-wrapper {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        overflow: hidden;
        transition: all 0.2s;
    }

    .quill-wrapper:focus-within {
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    .ql-toolbar.ql-snow {
        border: none;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
        padding: 0.5rem;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .ql-container.ql-snow {
        border: none;
    }

    .image-preview {
        width: 200px;
        height: 150px;
        object-fit: cover;
        border-radius: 0.75rem;
        border: 2px solid #e5e7eb;
    }
</style>

<main class="flex-1 overflow-y-auto p-4 md:p-8 space-y-10">

    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Homepage</h1>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <form action="/homepage/save" method="POST" class="space-y-8 pb-16">

        <!-- General Info -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">General Info</span>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Site title</label>
                <input type="text" name="site_title" value="<%= data.site_title %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
            </div>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">About / bio paragraph</label>
                <p class="text-xs text-gray-400 mb-1">Bold, italic, lists, and links are supported.</p>
                <div class="quill-wrapper">
                    <div id="aboutEditor"></div>
                </div>
                <input type="hidden" name="about_paragraph" id="aboutInput" value='<%= data.about_paragraph %>'>
            </div>
        </div>

        <!-- Book Showcase Section -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Book Showcase</span>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Book Section Title</label>
                <input type="text" name="book_showcase_title" value="<%= data.book_showcase.title %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
            </div>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Book Description</label>
                <p class="text-xs text-gray-400 mb-1">Bold, italic, lists, and links are supported.</p>
                <div class="quill-wrapper">
                    <div id="bookDescriptionEditor"></div>
                </div>
                <input type="hidden" name="book_showcase_description" id="bookDescriptionInput"
                    value='<%= data.book_showcase.description %>'>
            </div>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Section Image</label>
                <div class="space-y-3">
                    <input type="text" name="book_showcase_image" value="<%= data.book_showcase.image %>"
                        placeholder="Image URL"
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                    <% if (data.book_showcase.image) { %>
                    <div class="relative inline-block">
                        <img src="<%= data.book_showcase.image %>" alt="Book showcase image" class="image-preview">
                        <button type="button"
                            onclick="document.querySelector('input[name=book_showcase_image]').value = ''; this.closest('.relative').querySelector('img').src = '';"
                            class="absolute -top-2 -right-2 p-1 bg-red-500 text-white rounded-full hover:bg-red-600 transition-colors shadow-lg">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <% } %>
                    <p class="text-xs text-gray-400">Enter a URL to an image, or upload via the Images section.</p>
                </div>
            </div>
        </div>

        <!-- Author Bio Section -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Author Bio</span>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Author Bio Heading</label>
                <input type="text" name="author_bio_heading" value="<%= data.author_bio.heading %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
            </div>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Author Bio Text</label>
                <p class="text-xs text-gray-400 mb-1">Bold, italic, lists, and links are supported.</p>
                <div class="quill-wrapper">
                    <div id="authorBioEditor"></div>
                </div>
                <input type="hidden" name="author_bio_text" id="authorBioInput" value='<%= data.author_bio.text %>'>
            </div>
        </div>

        <!-- Contact Section -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Contact Section</span>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Contact Section Title</label>
                <input type="text" name="contact_section_title" value="<%= data.contact_section.title %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
            </div>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Contact Description</label>
                <p class="text-xs text-gray-400 mb-1">Bold, italic, lists, and links are supported.</p>
                <div class="quill-wrapper">
                    <div id="contactDescriptionEditor"></div>
                </div>
                <input type="hidden" name="contact_section_description" id="contactDescriptionInput"
                    value='<%= data.contact_section.description %>'>
            </div>
        </div>

        <!-- Journal Section -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Journal Section</span>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Journal Section Title</label>
                <input type="text" name="journal_section_title" value="<%= data.journal_section.title %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
            </div>
        </div>

        <div class="pt-4">
            <button type="submit"
                class="bg-[#335F55] hover:bg-[#284B43] text-white px-5 py-2.5 rounded-lg text-sm font-medium tracking-wide shadow-sm transition-colors focus:outline-none">
                Save Homepage Settings
            </button>
        </div>

    </form>
</main>

</div>

<!-- Quill.js JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
    lucide.createIcons();

    // ============ INITIALIZE QUILL EDITORS ============

    const toolbarOptions = [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        ['link'],
        ['clean']
    ];

    function initQuill(containerId, inputId, placeholder = '') {
        const container = document.getElementById(containerId);
        const input = document.getElementById(inputId);

        if (!container || !input) return null;

        const quill = new Quill(container, {
            modules: { toolbar: toolbarOptions },
            theme: 'snow',
            placeholder: placeholder
        });

        if (input.value) {
            quill.root.innerHTML = input.value;
        }

        quill.on('text-change', function () {
            input.value = quill.root.innerHTML;
        });

        return quill;
    }

    document.addEventListener('DOMContentLoaded', function () {
        initQuill('aboutEditor', 'aboutInput', 'Write your about paragraph...');
        initQuill('bookDescriptionEditor', 'bookDescriptionInput', 'Write your book description...');
        initQuill('authorBioEditor', 'authorBioInput', 'Write your author bio...');
        initQuill('contactDescriptionEditor', 'contactDescriptionInput', 'Write your contact description...');
        lucide.createIcons();
    });

    // ============ SIDEBAR FUNCTIONS ============

    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('flex');
        overlay.classList.remove('hidden');
    }

    function closeMenu() {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
        overlay.classList.add('hidden');
    }

    menuToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.add('hidden');
        } else {
            closeMenu();
        }
    });
</script>
</body>

</html>