<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .ql-container {
        font-size: 14px;
        min-height: 100px;
    }

    .ql-editor {
        min-height: 100px;
    }

    .ql-editor p {
        margin-bottom: 0.75rem;
    }

    .ql-editor ul,
    .ql-editor ol {
        padding-left: 1.5rem;
        margin: 0.5rem 0;
    }

    .quill-wrapper {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        overflow: hidden;
        transition: all 0.2s;
    }

    .quill-wrapper:focus-within {
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    .ql-toolbar.ql-snow {
        border: none;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
        padding: 0.5rem;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .ql-container.ql-snow {
        border: none;
    }

    .recipe-card {
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 1.25rem;
        background: white;
        transition: all 0.2s;
    }

    .recipe-card:hover {
        border-color: #d1d5db;
    }

    .recipe-card .field-label {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #9ca3af;
        margin-bottom: 0.25rem;
    }

    .recipe-card .field-value {
        font-size: 0.875rem;
        color: #1f2937;
        padding: 0.5rem 0.75rem;
        background: #f8fafc;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        white-space: pre-wrap;
        font-family: inherit;
        min-height: 2.5rem;
    }
</style>

<main class="flex-1 overflow-y-auto p-4 md:p-8 space-y-10">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Castor Oil Benefits Page</h1>
    </div>

    <% if (locals.success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (locals.error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <form action="/benefits-page/save" method="POST" class="space-y-8 pb-16">
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Intro Text</span>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Page title</label>
                <input type="text" name="page_title"
                    value="<%= (locals.data && data.page_title) ? data.page_title : '' %>"
                    class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
            </div>

            <div class="space-y-1.5">
                <label class="block text-sm font-medium text-gray-900">Intro paragraph</label>
                <p class="text-xs text-gray-400 mb-1">Bold, italic, lists, and links are supported.</p>
                <div class="quill-wrapper">
                    <div id="introEditor"></div>
                </div>
                <input type="hidden" name="intro_paragraph" id="introInput"
                    value="<%= (locals.data && data.intro_paragraph) ? data.intro_paragraph : '' %>">
            </div>
        </div>

        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">Associated
                    Recipes</span>
                <button type="button" id="add-recipe-btn"
                    class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 px-3.5 py-2 rounded-lg text-xs font-semibold shadow-sm flex items-center gap-1.5 focus:outline-none">
                    <i data-lucide="plus" class="w-3.5 h-3.5 text-gray-500"></i> Add recipe
                </button>
            </div>

            <div id="recipes-container" class="space-y-4">
                <% if (locals.data && data.associated_recipes && data.associated_recipes.length > 0) { %>
                <% data.associated_recipes.forEach((recipeId, index) => { %>
                <% const recipe = recipes.find(r => r.id === recipeId); %>
                <% if (recipe) { %>
                <div class="recipe-card group">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3">
                                <div class="p-1.5 text-gray-400 cursor-grab">
                                    <i data-lucide="grip-vertical" class="w-4 h-4"></i>
                                </div>
                                <span class="text-sm font-semibold text-gray-900">Recipe <%= index + 1 %></span>
                            </div>
                        </div>
                        <!-- FIXED: Use a proper form with method POST for deletion -->
                        <% if (recipe.id) { %>
                        <!-- In the recipe card, replace the delete form with this -->
                        <!-- Replace your current delete button with this -->
                        <button type="button" onclick="deleteRecipe(<%= recipe.id %>)"
                            class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                            title="Delete recipe permanently">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>


                        <% } else { %>
                        <button type="button" onclick="this.closest('.recipe-card').remove()"
                            class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                        <% } %>
                    </div>

                    <div class="grid grid-cols-1 gap-4 mt-3">
                        <div>
                            <div class="field-label">Title</div>
                            <input type="text" name="recipes[<%= index %>][title]" value="<%= recipe.title %>"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                        </div>

                        <div>
                            <div class="field-label">Ingredients (one per line)</div>
                            <textarea name="recipes[<%= index %>][ingredients]" rows="4"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC] font-mono text-xs"><%= recipe.ingredients %></textarea>
                        </div>

                        <div>
                            <div class="field-label">Instructions</div>
                            <textarea name="recipes[<%= index %>][instructions]" rows="3"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]"><%= recipe.instructions %></textarea>
                        </div>

                        <div>
                            <div class="field-label">To Use</div>
                            <textarea name="recipes[<%= index %>][howToUse]" rows="2"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]"><%= recipe.howToUse %></textarea>
                        </div>

                        <div>
                            <div class="field-label">Frequency of use</div>
                            <input type="text" name="recipes[<%= index %>][frequency]" value="<%= recipe.frequency %>"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                        </div>

                        <div>
                            <div class="field-label">Shelf life</div>
                            <input type="text" name="recipes[<%= index %>][shelfLife]" value="<%= recipe.shelfLife %>"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                        </div>

                        <input type="hidden" name="recipes[<%= index %>][id]" value="<%= recipe.id %>">
                    </div>
                </div>
                <% } %>
                <% }); %>
                <% } else { %>
                <div
                    class="text-center py-8 text-gray-400 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                    <i data-lucide="book-open" class="w-10 h-10 mx-auto mb-2 text-gray-300"></i>
                    <p class="text-sm">No recipes associated yet. Click "Add recipe" to get started.</p>
                </div>
                <% } %>
            </div>
        </div>

        <hr class="border-gray-200 my-8">

        <div class="space-y-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block">FAQ part</span>

            <div id="faq-container" class="space-y-4">
                <% if (locals.data && data.faqs) { %>
                <% data.faqs.forEach((faq, index) => { %>
                <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm flex gap-4 items-start group relative"
                    data-id="<%= faq.id %>">
                    <div class="flex-1 space-y-3">
                        <div class="space-y-1">
                            <label class="text-xs font-medium text-gray-400">Question</label>
                            <input type="text" name="faq[<%= index %>][question]" value="<%= faq.question %>"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none bg-[#F8FAFC]">
                        </div>
                        <div class="space-y-1">
                            <label class="text-xs font-medium text-gray-400">Answer</label>
                            <textarea name="faq[<%= index %>][answer]" rows="2"
                                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none bg-[#F8FAFC] leading-relaxed"><%= faq.answer %></textarea>
                        </div>
                    </div>

                    <div class="flex flex-col items-center gap-1 text-gray-400 pt-5">
                        <button type="submit" form="form-up-<%= faq.id %>"
                            class="p-1.5 hover:bg-gray-50 rounded-md hover:text-gray-700 transition-colors">
                            <i data-lucide="arrow-up" class="w-4 h-4"></i>
                        </button>
                        <button type="submit" form="form-down-<%= faq.id %>"
                            class="p-1.5 hover:bg-gray-50 rounded-md hover:text-gray-700 transition-colors">
                            <i data-lucide="arrow-down" class="w-4 h-4"></i>
                        </button>
                        <button type="submit" form="form-delete-<%= faq.id %>"
                            class="p-1.5 hover:bg-red-50 rounded-md hover:text-red-500 transition-colors mt-1">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
                <% }); %>
                <% } %>
            </div>

            <button type="button" id="add-faq-btn"
                class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 px-3.5 py-2 rounded-lg text-xs font-semibold shadow-sm flex items-center gap-1.5 focus:outline-none">
                <i data-lucide="plus" class="w-3.5 h-3.5 text-gray-500"></i> Add FAQ
            </button>
        </div>

        <div class="pt-4">
            <button type="submit"
                class="bg-[#335F55] hover:bg-[#284B43] text-white px-5 py-2.5 rounded-lg text-sm font-medium tracking-wide shadow-sm transition-colors focus:outline-none">
                Save Benefits Page
            </button>
        </div>
    </form>
</main>

<% if (locals.data && data.faqs) { %>
<% data.faqs.forEach((faq) => { %>
<form id="form-up-<%= faq.id %>" action="/benefits-page/faq/move-up/<%= faq.id %>" method="POST" class="hidden"></form>
<form id="form-down-<%= faq.id %>" action="/benefits-page/faq/move-down/<%= faq.id %>" method="POST" class="hidden">
</form>
<form id="form-delete-<%= faq.id %>" action="/benefits-page/faq/delete/<%= faq.id %>" method="POST" class="hidden"
    onsubmit="return confirm('Delete this FAQ?');"></form>
<% }); %>
<% } %>

<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<!-- Add this JavaScript function -->
<script>
    function deleteRecipe(recipeId) {
        if (!confirm('Delete this recipe? This action cannot be undone.')) {
            return;
        }

        // Create a form dynamically
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/benefits-page/recipe/delete/${recipeId}`;
        document.body.appendChild(form);
        form.submit();
    }
</script>
<script>
    lucide.createIcons();

    // ============ INITIALIZE QUILL EDITOR ============
    const toolbarOptions = [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        ['link'],
        ['clean']
    ];

    function initQuill(containerId, inputId, placeholder = '') {
        const container = document.getElementById(containerId);
        const input = document.getElementById(inputId);

        if (!container || !input) return null;

        const quill = new Quill(container, {
            modules: { toolbar: toolbarOptions },
            theme: 'snow',
            placeholder: placeholder
        });

        if (input.value) {
            quill.root.innerHTML = input.value;
        }

        quill.on('text-change', function () {
            input.value = quill.root.innerHTML;
        });

        return quill;
    }

    document.addEventListener('DOMContentLoaded', function () {
        initQuill('introEditor', 'introInput', 'Write your intro paragraph...');
        lucide.createIcons();
    });

    // ============ RECIPES MANAGEMENT ============
    let recipeCount = <%= (locals.data && data.associated_recipes) ? data.associated_recipes.length : 0 %>;

    function getRecipeOptions() {
        const options = `<option value="">Select a recipe...</option>
            <% if(locals.recipes) { recipes.forEach(r => { %>
                <option value="<%= r.id %>"><%= r.title %></option>
            <% }); } %>`;
        return options;
    }

    const recipesContainer = document.getElementById('recipes-container');
    const addRecipeBtn = document.getElementById('add-recipe-btn');

    if (addRecipeBtn && recipesContainer) {
        addRecipeBtn.addEventListener('click', () => {
            const recipeRowMarkup = `
        <div class="recipe-card group">
            <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 text-gray-400 cursor-grab">
                            <i data-lucide="grip-vertical" class="w-4 h-4"></i>
                        </div>
                        <span class="text-sm font-semibold text-gray-900">Recipe ${recipeCount + 1}</span>
                    </div>
                </div>
                <button type="button" onclick="this.closest('.recipe-card').remove()"
                    class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="grid grid-cols-1 gap-4 mt-3">
                <div>
                    <div class="field-label">Title</div>
                    <input type="text" name="recipes[${recipeCount}][title]" value="New Recipe"
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                </div>
                <div>
                    <div class="field-label">Ingredients (one per line)</div>
                    <textarea name="recipes[${recipeCount}][ingredients]" rows="4"
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC] font-mono text-xs"></textarea>
                </div>
                <div>
                    <div class="field-label">Instructions</div>
                    <textarea name="recipes[${recipeCount}][instructions]" rows="3"
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]"></textarea>
                </div>
                <div>
                    <div class="field-label">To Use</div>
                    <textarea name="recipes[${recipeCount}][howToUse]" rows="2"
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]"></textarea>
                </div>
                <div>
                    <div class="field-label">Frequency of use</div>
                    <input type="text" name="recipes[${recipeCount}][frequency]" value="Use sparingly."
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                </div>
                <div>
                    <div class="field-label">Shelf life</div>
                    <input type="text" name="recipes[${recipeCount}][shelfLife]" value="Store in a cool, dry place."
                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-[#F8FAFC]">
                </div>
                <input type="hidden" name="recipes[${recipeCount}][id]" value="0">
            </div>
        </div>
        `;
            recipesContainer.insertAdjacentHTML('beforeend', recipeRowMarkup);
            recipeCount++;
            lucide.createIcons();
        });
    }

    // ============ FAQ MANAGEMENT ============
    const faqContainer = document.getElementById('faq-container');
    const addFaqBtn = document.getElementById('add-faq-btn');

    if (addFaqBtn && faqContainer) {
        addFaqBtn.addEventListener('click', () => {
            const currentItemsCount = faqContainer.querySelectorAll('.group').length;
            const faqCardMarkup = `
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm flex gap-4 items-start group relative">
                <div class="flex-1 space-y-3">
                    <div class="space-y-1">
                        <label class="text-xs font-medium text-gray-400">Question</label>
                        <input type="text" name="faq[${currentItemsCount}][question]" placeholder="Enter question..." 
                            class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none bg-[#F8FAFC]">
                    </div>
                    <div class="space-y-1">
                        <label class="text-xs font-medium text-gray-400">Answer</label>
                        <textarea name="faq[${currentItemsCount}][answer]" rows="2" placeholder="Enter answer..." 
                            class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none bg-[#F8FAFC] leading-relaxed"></textarea>
                    </div>
                </div>
                <div class="flex flex-col items-center gap-1 text-gray-400 pt-5">
                    <button type="button" class="p-1.5 hover:bg-gray-50 rounded-md hover:text-gray-700 transition-colors">
                        <i data-lucide="arrow-up" class="w-4 h-4"></i>
                    </button>
                    <button type="button" class="p-1.5 hover:bg-gray-50 rounded-md hover:text-gray-700 transition-colors">
                        <i data-lucide="arrow-down" class="w-4 h-4"></i>
                    </button>
                    <button type="button" onclick="this.closest('.group').remove()" 
                        class="p-1.5 hover:bg-red-50 rounded-md hover:text-red-500 transition-colors mt-1">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
            `;
            faqContainer.insertAdjacentHTML('beforeend', faqCardMarkup);
            lucide.createIcons();
        });
    }

    // ============ SIDEBAR FUNCTIONS ============
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('flex');
        overlay.classList.remove('hidden');
    }

    function closeMenu() {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
        overlay.classList.add('hidden');
    }

    menuToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.add('hidden');
        } else {
            closeMenu();
        }
    });
</script>
</body>

</html>