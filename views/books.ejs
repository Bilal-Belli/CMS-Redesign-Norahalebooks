<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<!-- Quill.js CSS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .ql-container {
        font-size: 14px;
        min-height: 150px;
    }

    .ql-editor {
        min-height: 150px;
    }

    .ql-editor p {
        margin-bottom: 0.75rem;
    }

    .ql-editor ul,
    .ql-editor ol {
        padding-left: 1.5rem;
        margin: 0.5rem 0;
    }

    .ql-editor h2 {
        font-size: 1.5rem;
        font-weight: bold;
        margin: 0.5rem 0;
    }

    .ql-editor h3 {
        font-size: 1.25rem;
        font-weight: bold;
        margin: 0.5rem 0;
    }

    .quill-wrapper {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        overflow: hidden;
        transition: all 0.2s;
    }

    .quill-wrapper:focus-within {
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    .ql-toolbar.ql-snow {
        border: none;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
        padding: 0.5rem;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .ql-container.ql-snow {
        border: none;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.625rem;
        font-weight: 500;
    }

    .status-badge.published {
        background: #dcfce7;
        color: #166534;
    }

    .status-badge.draft {
        background: #f3f4f6;
        color: #6b7280;
    }
</style>

<main class="flex-1 overflow-y-auto p-4 md:p-8">

    <!-- Flash Messages -->
    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <% if (viewMode === 'list') { %>

    <div class="flex items-center justify-between gap-4 mb-6 md:mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Books</h1>
        <a href="/books/new"
            class="inline-flex items-center gap-2 bg-[#335F55] hover:bg-[#284B43] text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm transition-colors">
            <i data-lucide="plus" class="w-4 h-4"></i> New Book
        </a>
    </div>

    <div class="space-y-4">
        <% books.forEach(book => { %>
        <div
            class="bg-white border border-gray-200 rounded-xl p-4 flex items-center justify-between gap-4 shadow-sm hover:border-gray-300 transition-all">
            <div class="flex items-center gap-4 min-w-0 flex-1">
                <img src="<%= book.cover_image || 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&q=80&w=120' %>"
                    alt="<%= book.title %>"
                    class="w-12 h-16 object-cover rounded-md border border-gray-100 shrink-0 shadow-sm">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="font-semibold text-gray-900 truncate"><%= book.title %></h2>
                        <span class="status-badge <%= book.is_published ? 'published' : 'draft' %>">
                            <i data-lucide="<%= book.is_published ? 'eye' : 'eye-off' %>" class="w-3 h-3"></i>
                            <%= book.is_published ? 'Published' : 'Draft' %>
                        </span>
                    </div>
                    <p class="text-xs font-mono text-gray-400 truncate">/books/<%= book.slug %></p>
                </div>
            </div>
            <div class="flex items-center gap-1 shrink-0">
                <form action="/books/move-up/<%= book.id %>" method="POST" class="inline">
                    <button type="submit"
                        class="p-1.5 text-gray-400 hover:text-gray-900 hover:bg-gray-50 rounded-md transition-colors">
                        <i data-lucide="arrow-up" class="w-4 h-4"></i>
                    </button>
                </form>
                <form action="/books/move-down/<%= book.id %>" method="POST" class="inline">
                    <button type="submit"
                        class="p-1.5 text-gray-400 hover:text-gray-900 hover:bg-gray-50 rounded-md transition-colors">
                        <i data-lucide="arrow-down" class="w-4 h-4"></i>
                    </button>
                </form>
                <form action="/books/toggle-visibility/<%= book.id %>" method="POST" class="inline">
                    <button type="submit"
                        class="p-1.5 text-gray-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors"
                        title="Toggle visibility">
                        <i data-lucide="<%= book.is_published ? 'eye' : 'eye-off' %>" class="w-4 h-4"></i>
                    </button>
                </form>
                <a href="/books/edit/<%= book.id %>"
                    class="p-1.5 text-gray-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors">
                    <i data-lucide="file-text" class="w-4 h-4"></i>
                </a>
                <form action="/books/delete/<%= book.id %>" method="POST"
                    onsubmit="return confirm('Delete this book?');" class="inline">
                    <button type="submit"
                        class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </form>
            </div>
        </div>
        <% }) %>

        <% if (books.length === 0) { %>
        <div class="text-center py-12 border border-dashed border-gray-200 rounded-xl bg-white text-gray-400">
            <i data-lucide="book-open" class="w-12 h-12 mx-auto mb-3 text-gray-300"></i>
            <p class="text-sm">No books created yet. Click "New Book" to get started.</p>
        </div>
        <% } %>
    </div>

    <% } else if (viewMode === 'edit') { %>

    <div class="flex items-center justify-between gap-4 mb-6 md:mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900"><%= isEdit ? 'Edit Book' : 'New Book' %></h1>
        <a href="/books"
            class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium shadow-sm transition-colors">Cancel</a>
    </div>

    <form action="/books/save" method="POST" class="space-y-6 max-w-4xl pb-12">
        <input type="hidden" name="id" value="<%= isEdit ? book.id : '' %>">

        <!-- Title -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Title</label>
            <input type="text" name="title" value="<%= isEdit ? book.title : '' %>" required
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <!-- Subtitle -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Subtitle</label>
            <input type="text" name="subtitle" value="<%= isEdit ? book.subtitle : '' %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <!-- Slug -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">URL slug</label>
            <input type="text" name="slug" value="<%= isEdit ? book.slug : '' %>" required
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all font-mono">
            <p class="text-xs text-gray-400 mt-1.5">Will appear at /books/slug</p>
        </div>

        <!-- Cover Image -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Cover image URL</label>
            <input type="text" name="cover_image" value="<%= isEdit ? book.cover_image : '' %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all font-mono text-xs">
            <% if (isEdit && book.cover_image) { %>
            <div class="mt-3 w-32 aspect-[3/4] border border-gray-200 rounded-lg overflow-hidden bg-gray-50 shadow-sm">
                <img src="<%= book.cover_image %>" class="w-full h-full object-cover">
            </div>
            <% } %>
        </div>

        <!-- Description (Quill Editor) -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Description</label>
            <p class="text-xs text-gray-400 mb-2">Bold, italic, lists, and links are supported.</p>
            <div class="quill-wrapper">
                <div id="descriptionEditor"></div>
            </div>
            <input type="hidden" name="description" id="descriptionInput" value='<%= isEdit ? book.description : '' %>'>
        </div>

        <!-- Medical Note (Quill Editor) -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Medical / closing note</label>
            <p class="text-xs text-gray-400 mb-2">Optional closing note or disclaimer.</p>
            <div class="quill-wrapper">
                <div id="medicalNoteEditor"></div>
            </div>
            <input type="hidden" name="medical_note" id="medicalNoteInput"
                value='<%= isEdit ? book.medical_note : '' %>'>
        </div>

        <!-- Buy Buttons -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Buy buttons</label>
            <div id="buy-buttons-container" class="space-y-3">
                <% if (isEdit && book.buy_buttons && book.buy_buttons.length > 0) { %>
                <% book.buy_buttons.forEach((btn, index) => { %>
                <div class="flex items-center gap-3 buy-button-row">
                    <input type="text" name="buy_buttons_label_<%= index %>" value="<%= btn.label %>"
                        placeholder="Button label"
                        class="w-1/4 min-w-[120px] bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 focus:outline-none">
                    <input type="text" name="buy_buttons_url_<%= index %>" value="<%= btn.url %>"
                        placeholder="Button URL"
                        class="flex-1 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm font-mono text-gray-600 focus:outline-none">
                    <button type="button" onclick="this.closest('.buy-button-row').remove()"
                        class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
                <% }); %>
                <% } else { %>
                <div class="flex items-center gap-3 buy-button-row">
                    <input type="text" name="buy_buttons_label_0" value="Buy on Amazon" placeholder="Button label"
                        class="w-1/4 min-w-[120px] bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 focus:outline-none">
                    <input type="text" name="buy_buttons_url_0" value="https://www.amazon.com/dp/..."
                        placeholder="Button URL"
                        class="flex-1 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm font-mono text-gray-600 focus:outline-none">
                    <button type="button" onclick="this.closest('.buy-button-row').remove()"
                        class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
                <% } %>
            </div>
            <input type="hidden" name="buy_buttons" id="buyButtonsInput"
                value='<%= isEdit ? JSON.stringify(book.buy_buttons || []) : '[]' %>'>
            <button type="button" onclick="addBuyButton()"
                class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white border border-gray-200 text-gray-700 px-3 py-1.5 rounded-lg shadow-sm hover:bg-gray-50 transition-colors mt-3">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add button
            </button>
        </div>

        <!-- Benefits -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">What's Inside (Benefits)</label>
            <div id="benefits-container" class="space-y-3">
                <% if (isEdit && book.benefits && book.benefits.length > 0) { %>
                <% book.benefits.forEach((benefit, index) => { %>
                <div
                    class="flex items-start gap-3 bg-white border border-gray-100 p-4 rounded-xl shadow-sm benefit-row">
                    <div class="flex-1 space-y-3">
                        <input type="text" name="benefits_title_<%= index %>" value="<%= benefit.title %>"
                            placeholder="Benefit title"
                            class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2 text-sm font-semibold text-gray-900 focus:outline-none">
                        <textarea name="benefits_desc_<%= index %>" rows="2" placeholder="Benefit description"
                            class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-600 focus:outline-none resize-none"><%= benefit.description %></textarea>
                    </div>
                    <button type="button" onclick="this.closest('.benefit-row').remove()"
                        class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors shrink-0">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
                <% }); %>
                <% } else { %>
                <div
                    class="flex items-start gap-3 bg-white border border-gray-100 p-4 rounded-xl shadow-sm benefit-row">
                    <div class="flex-1 space-y-3">
                        <input type="text" name="benefits_title_0" value="Unlock Practical Solutions"
                            placeholder="Benefit title"
                            class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2 text-sm font-semibold text-gray-900 focus:outline-none">
                        <textarea name="benefits_desc_0" rows="2" placeholder="Benefit description"
                            class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-600 focus:outline-none resize-none">Learn science-backed habits that sharpen your mind, improve your sleep, and reduce stress effortlessly.</textarea>
                    </div>
                    <button type="button" onclick="this.closest('.benefit-row').remove()"
                        class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors shrink-0">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
                <% } %>
            </div>
            <input type="hidden" name="benefits" id="benefitsInput"
                value='<%= isEdit ? JSON.stringify(book.benefits || []) : '[]' %>'>
            <button type="button" onclick="addBenefit()"
                class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white border border-gray-200 text-gray-700 px-3 py-1.5 rounded-lg shadow-sm hover:bg-gray-50 transition-colors mt-3">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add benefit
            </button>
        </div>

        <!-- Table of Contents -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Table of Contents</label>
            <div id="toc-container" class="space-y-2">
                <% if (isEdit && book.table_of_contents && book.table_of_contents.length > 0) { %>
                <% book.table_of_contents.forEach((item, index) => { %>
                <div class="flex items-center gap-3 toc-row">
                    <input type="text" name="toc_<%= index %>" value="<%= item %>" placeholder="Chapter title"
                        class="flex-1 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 focus:outline-none">
                    <button type="button" onclick="this.closest('.toc-row').remove()"
                        class="p-2.5 text-gray-400 hover:text-red-600 rounded-lg">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
                <% }); %>
                <% } else { %>
                <div class="flex items-center gap-3 toc-row">
                    <input type="text" name="toc_0" value="Introduction" placeholder="Chapter title"
                        class="flex-1 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 focus:outline-none">
                    <button type="button" onclick="this.closest('.toc-row').remove()"
                        class="p-2.5 text-gray-400 hover:text-red-600 rounded-lg">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
                <% } %>
            </div>
            <input type="hidden" name="table_of_contents" id="tocInput"
                value='<%= isEdit ? JSON.stringify(book.table_of_contents || []) : '[]' %>'>
            <button type="button" onclick="addTOC()"
                class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white border border-gray-200 text-gray-700 px-3 py-1.5 rounded-lg shadow-sm hover:bg-gray-50 transition-colors mt-3">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add chapter
            </button>
        </div>

        <!-- Published Status -->
        <div class="pt-4 border-t border-gray-200">
            <label class="flex items-center gap-3 cursor-pointer select-none">
                <input type="checkbox" name="is_published" <%= (isEdit && book.is_published) ? 'checked' : '' %>
                    class="w-4 h-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500/30 cursor-pointer">
                <span class="text-sm font-medium text-gray-900">Published</span>
                <span class="text-xs text-gray-400">(Visible to visitors)</span>
            </label>
        </div>

        <div class="pt-6 pb-12 flex items-center gap-3">
            <button type="submit"
                class="bg-[#335F55] hover:bg-[#284B43] text-white px-6 py-2.5 rounded-lg text-sm font-medium tracking-wide shadow-sm transition-colors focus:outline-none">
                <%= isEdit ? 'Save Book Changes' : 'Create Book' %>
            </button>
            <a href="/books"
                class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2.5 rounded-lg text-sm font-medium transition-colors">
                Cancel
            </a>
        </div>
    </form>
    <% } %>

</main>

</div>

<!-- Quill.js JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
    lucide.createIcons();

    // ============ INITIALIZE QUILL EDITORS ============

    const toolbarOptions = [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block'],
        [{ 'header': [1, 2, 3, false] }],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        [{ 'indent': '-1' }, { 'indent': '+1' }],
        ['link', 'image'],
        ['clean']
    ];

    function initQuill(containerId, inputId, placeholder = '') {
        const container = document.getElementById(containerId);
        const input = document.getElementById(inputId);

        if (!container || !input) return null;

        const quill = new Quill(container, {
            modules: { toolbar: toolbarOptions },
            theme: 'snow',
            placeholder: placeholder
        });

        if (input.value) {
            quill.root.innerHTML = input.value;
        }

        quill.on('text-change', function () {
            input.value = quill.root.innerHTML;
        });

        return quill;
    }

    document.addEventListener('DOMContentLoaded', function () {
        initQuill('descriptionEditor', 'descriptionInput', 'Write your book description...');
        initQuill('medicalNoteEditor', 'medicalNoteInput', 'Write your medical note or disclaimer...');
        lucide.createIcons();
    });

    // ============ BUY BUTTONS ============

    let buyButtonCount = <%= isEdit && book.buy_buttons ? book.buy_buttons.length : 1 %>;

    function addBuyButton() {
        const container = document.getElementById('buy-buttons-container');
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 buy-button-row';
        row.innerHTML = `
            <input type="text" name="buy_buttons_label_${buyButtonCount}" value="New Button" placeholder="Button label"
                class="w-1/4 min-w-[120px] bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 focus:outline-none">
            <input type="text" name="buy_buttons_url_${buyButtonCount}" value="https://..." placeholder="Button URL"
                class="flex-1 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm font-mono text-gray-600 focus:outline-none">
            <button type="button" onclick="this.closest('.buy-button-row').remove()"
                class="p-2.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
        `;
        container.appendChild(row);
        buyButtonCount++;
        lucide.createIcons();
    }

    // ============ BENEFITS ============

    let benefitCount = <%= isEdit && book.benefits ? book.benefits.length : 1 %>;

    function addBenefit() {
        const container = document.getElementById('benefits-container');
        const row = document.createElement('div');
        row.className = 'flex items-start gap-3 bg-white border border-gray-100 p-4 rounded-xl shadow-sm benefit-row';
        row.innerHTML = `
            <div class="flex-1 space-y-3">
                <input type="text" name="benefits_title_${benefitCount}" value="New Benefit" placeholder="Benefit title"
                    class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2 text-sm font-semibold text-gray-900 focus:outline-none">
                <textarea name="benefits_desc_${benefitCount}" rows="2" placeholder="Benefit description"
                    class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-600 focus:outline-none resize-none"></textarea>
            </div>
            <button type="button" onclick="this.closest('.benefit-row').remove()"
                class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors shrink-0">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
        `;
        container.appendChild(row);
        benefitCount++;
        lucide.createIcons();
    }

    // ============ TABLE OF CONTENTS ============

    let tocCount = <%= isEdit && book.table_of_contents ? book.table_of_contents.length : 1 %>;

    function addTOC() {
        const container = document.getElementById('toc-container');
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 toc-row';
        row.innerHTML = `
            <input type="text" name="toc_${tocCount}" value="New Chapter" placeholder="Chapter title"
                class="flex-1 bg-[#F8FAFC] border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 focus:outline-none">
            <button type="button" onclick="this.closest('.toc-row').remove()"
                class="p-2.5 text-gray-400 hover:text-red-600 rounded-lg">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
        `;
        container.appendChild(row);
        tocCount++;
        lucide.createIcons();
    }

    // ============ SIDEBAR FUNCTIONS ============

    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('flex');
        overlay.classList.remove('hidden');
    }

    function closeMenu() {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
        overlay.classList.add('hidden');
    }

    menuToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.add('hidden');
        } else {
            closeMenu();
        }
    });
</script>
</body>

</html>