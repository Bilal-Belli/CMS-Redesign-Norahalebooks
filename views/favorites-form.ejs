<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<!-- Quill.js CSS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .ql-container {
        font-size: 14px;
        min-height: 100px;
    }

    .ql-editor {
        min-height: 100px;
    }

    .ql-editor p {
        margin-bottom: 0.75rem;
    }

    .ql-editor ul,
    .ql-editor ol {
        padding-left: 1.5rem;
        margin: 0.5rem 0;
    }

    .quill-wrapper {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        overflow: hidden;
        transition: all 0.2s;
    }

    .quill-wrapper:focus-within {
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
    }

    .ql-toolbar.ql-snow {
        border: none;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
        padding: 0.5rem;
        border-radius: 0.75rem 0.75rem 0 0;
    }

    .ql-container.ql-snow {
        border: none;
    }
</style>

<main class="flex-1 overflow-y-auto p-4 md:p-8">

    <div class="mb-6">
        <a href="/favorites"
            class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 mb-4 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Favorites
        </a>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">
            <%= isEdit ? 'Edit Product' : 'New Product' %>
        </h1>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <form action="/favorites/product/save" method="POST"
        class="space-y-6 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

        <% if (isEdit) { %>
        <input type="hidden" name="id" value="<%= product.id %>">
        <% } %>

        <!-- Title -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Product Title</label>
            <input type="text" name="title" value="<%= product.title %>" required
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-white">
        </div>

        <!-- Image URL -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Image URL</label>
            <input type="text" name="image_url" value="<%= product.image_url %>"
                placeholder="https://images.unsplash.com/..."
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-white">
            <p class="text-xs text-gray-400 mt-1">Leave empty to use default image</p>
        </div>

        <!-- Category -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Category</label>
            <select name="category" required
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-white">
                <option value="">Select a category</option>
                <% categories.forEach(cat => { %>
                <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </div>

        <!-- Endorsement -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Endorsement</label>
            <input type="text" name="endorsement" value="<%= product.endorsement %>"
                placeholder="My absolute go-to for..."
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-white">
        </div>

        <!-- Description (Quill Editor) -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Description</label>
            <p class="text-xs text-gray-400 mb-2">Bold, italic, lists, and links are supported.</p>
            <div class="quill-wrapper">
                <div id="descriptionEditor"></div>
            </div>
            <input type="hidden" name="description" id="descriptionInput" value='<%= product.description %>'>
        </div>

        <!-- Buy URL -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Buy URL</label>
            <input type="text" name="buy_url" value="<%= product.buy_url %>" placeholder="https://www.amazon.com/..."
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-white">
        </div>

        <!-- Button Label -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-1">Button Label</label>
            <input type="text" name="button_label" value="<%= product.button_label || 'View on Amazon' %>"
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 bg-white">
        </div>

        <!-- Checkboxes -->
        <div class="space-y-2">
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input type="checkbox" name="is_featured" <%= product.is_featured ? 'checked' : '' %>>
                Featured Product
            </label>
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input type="checkbox" name="is_published" <%= product.is_published !== false ? 'checked' : '' %>>
                Published
            </label>
        </div>

        <!-- Buttons -->
        <div class="flex gap-3 pt-4">
            <button type="submit"
                class="bg-[#335F55] hover:bg-[#284B43] text-white px-5 py-2.5 rounded-lg text-sm font-medium tracking-wide shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-[#335F55]/30">
                Save Product
            </button>
            <a href="/favorites"
                class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2.5 rounded-lg text-sm font-medium transition-colors">
                Cancel
            </a>
        </div>

    </form>
</main>

</div>

<!-- Quill.js JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
    lucide.createIcons();

    // Initialize Quill editor for description
    const toolbarOptions = [
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote'],
        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
        ['link'],
        ['clean']
    ];

    const container = document.getElementById('descriptionEditor');
    const input = document.getElementById('descriptionInput');

    if (container) {
        const quill = new Quill(container, {
            modules: { toolbar: toolbarOptions },
            theme: 'snow',
            placeholder: 'Product description...'
        });

        // Set initial content
        if (input && input.value) {
            quill.root.innerHTML = input.value;
        }

        // Update hidden input on change
        quill.on('text-change', function () {
            if (input) {
                input.value = quill.root.innerHTML;
            }
        });
    }

    // Sidebar functions
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('flex');
        overlay.classList.remove('hidden');
    }

    function closeMenu() {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
        overlay.classList.add('hidden');
    }

    menuToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.add('hidden');
        } else {
            closeMenu();
        }
    });
</script>
</body>

</html>