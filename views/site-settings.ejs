<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 overflow-y-auto p-4 md:p-8">
    <div class="flex items-center justify-between mb-6 md:mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Site Settings</h1>
        <form action="/settings/reset" method="POST" onsubmit="return confirm('Reset all settings to defaults?');">
            <button type="submit" class="text-sm text-red-600 hover:text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-lg transition-colors">
                Reset to Defaults
            </button>
        </form>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
        <span><%= success %></span>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2 mb-6">
        <i data-lucide="alert-circle" class="h-5 w-5 text-red-500"></i>
        <span><%= error %></span>
    </div>
    <% } %>

    <form action="/settings/save" method="POST" class="space-y-6">
        <!-- Site Title -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Site Title</label>
            <input type="text" name="siteTitle" value="<%= settings.siteTitle %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <!-- Tagline -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Tagline</label>
            <input type="text" name="tagline" value="<%= settings.tagline %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <!-- Footer Text -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Footer Text</label>
            <input type="text" name="footerText" value="<%= settings.footerText %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <hr class="border-gray-200 my-8">

        <!-- OG Tags -->
        <div>
            <h2 class="text-xl font-bold text-gray-900 mb-1">Open Graph Tags</h2>
            <p class="text-sm text-gray-500 mb-6">Used for social media sharing previews</p>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">OG Title</label>
            <input type="text" name="ogTitle" value="<%= settings.ogTitle %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">OG Description</label>
            <textarea name="ogDescription" rows="3"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all resize-none"><%= settings.ogDescription %></textarea>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">OG Image URL</label>
            <input type="text" name="ogImageUrl" value="<%= settings.ogImageUrl %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <hr class="border-gray-200 my-8">

        <!-- Contact Email -->
        <div>
            <label class="block text-sm font-medium text-gray-900 mb-2">Contact form recipient email</label>
            <input type="email" name="contactEmail" value="<%= settings.contactEmail %>"
                class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
        </div>

        <hr class="border-gray-200 my-8">

        <!-- Navigation Labels -->
        <div class="pt-2">
            <h2 class="text-xl font-bold text-gray-900 mb-1">Navigation Labels</h2>
            <p class="text-sm text-gray-500 mb-6">Rename the buttons in the top navbar and footer.</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-900 mb-2">Home</label>
                    <input type="text" name="navHome" value="<%= settings.navigation.home %>"
                        class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-900 mb-2">About</label>
                    <input type="text" name="navAbout" value="<%= settings.navigation.about %>"
                        class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-900 mb-2">Book / Books</label>
                    <input type="text" name="navBooks" value="<%= settings.navigation.books %>"
                        class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-900 mb-2">Benefits</label>
                    <input type="text" name="navBenefits" value="<%= settings.navigation.benefits %>"
                        class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-900 mb-2">Blog</label>
                    <input type="text" name="navBlog" value="<%= settings.navigation.blog %>"
                        class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-900 mb-2">Contact</label>
                    <input type="text" name="navContact" value="<%= settings.navigation.contact %>"
                        class="w-full bg-[#F8FAFC] border border-gray-200 rounded-lg px-4 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-600 transition-all">
                </div>
            </div>
        </div>

        <div class="pt-4 pb-8 flex gap-3">
            <button type="submit"
                class="bg-[#335F55] hover:bg-[#284B43] text-white px-5 py-2.5 rounded-lg text-sm font-medium tracking-wide shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-[#335F55]/30">
                Save Settings
            </button>
            <a href="/settings" 
                class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2.5 rounded-lg text-sm font-medium tracking-wide transition-colors">
                Cancel
            </a>
        </div>
    </form>
</main>

</div>
<script>
    lucide.createIcons();

    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openMenu() {
        sidebar.classList.remove('hidden');
        sidebar.classList.add('flex');
        overlay.classList.remove('hidden');
    }

    function closeMenu() {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
        overlay.classList.add('hidden');
    }

    menuToggle.addEventListener('click', openMenu);
    menuClose.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);

    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.add('hidden');
        } else {
            closeMenu();
        }
    });
</script>
</body>
</html>