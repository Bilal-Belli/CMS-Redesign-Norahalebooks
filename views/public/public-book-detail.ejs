<%- include('../partials/public-header', { title: book.title + ' | ' + (settings?.siteTitle || 'Nora Hale Books'), settings: settings }) %>
<style>
    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1.5rem;
    }

    .contact-form-section {
        max-width: 500px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
    }

    .contact-subtitle {
        color: #6b7280;
        margin-bottom: 1.5rem;
        padding-left: 10%;
        padding-right: 10%;
    }

    .contact-form-section form {
        max-width: 500px;
        margin: 0 auto;
    }

    .contact-form-section .form-group {
        margin-bottom: 1rem;
    }

    .contact-form-section input,
    .contact-form-section textarea {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #f8fafc;
    }

    .contact-form-section input:focus,
    .contact-form-section textarea:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
        background: white;
    }

    .contact-form-section textarea {
        min-height: 100px;
        resize: vertical;
    }

    .contact-form-section .btn-send {
        padding: 0.75rem 2.5rem;
        background: #335F55;
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
    }

    .contact-form-section .btn-send:hover {
        background: #284B43;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 1.5rem;
        }

        .contact-form-section {
            padding: 1.5rem;
        }
    }
</style>
<style>
    .book-detail {
        max-width: 3xl;
        margin: 0 auto;
    }

    /* NEW: Flex layout for image + content */
    .book-detail .book-layout {
        display: flex;
        gap: 2.5rem;
        align-items: flex-start;
    }

    .book-detail .book-image {
        width: 50%;
        min-width: 50%;
        aspect-ratio: 3/4;
    }

    .book-detail .book-content {
        flex: 1;
        min-width: 0;
    }

    .book-detail .book-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.25rem;
    }

    .book-detail .book-subtitle {
        font-size: 1rem;
        color: #4b5563;
        font-weight: 500;
        margin-bottom: 1rem;
    }

    .book-detail .book-description {
        font-size: 1rem;
        color: #4b5563;
        line-height: 1.9;
    }

    .book-detail .book-description p {
        margin-bottom: 1rem;
    }

    .book-detail .book-description p:last-child {
        margin-bottom: 0;
    }

    .book-detail .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1f2937;
        margin: 2rem 0 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
    }

    .book-detail .buy-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.5rem 0;
    }

    .book-detail .buy-buttons a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: #335F55;
        color: white;
        border-radius: 0.5rem;
        font-size: 1rem;
        font-weight: 500;
        transition: background 0.2s;
    }

    .book-detail .buy-buttons a:hover {
        background: #284B43;
    }

    .book-detail .benefits-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        /* Change from 1fr 1fr to 1fr 1fr 1fr */
        gap: 1rem;
        margin: 1rem 0;
    }

    .book-detail .benefit-item {
        background: white;
        padding: 1rem;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
    }

    .book-detail .benefit-item .benefit-title {
        font-weight: 500;
        color: #1f2937;
        font-size: 1rem;
        margin-bottom: 0.75rem;
    }

    .book-detail .benefit-item .benefit-desc {
        font-size: 1rem;
        color: #6b7280;
        line-height: 1.6;
    }

    .book-detail .toc-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
    }

    .book-detail .toc-list li {
        padding: 0.75rem 0;
        border-bottom: 1px solid #e5e7eb;
        /* Add horizontal line */
        font-size: 1rem;
        color: #4b5563;
    }

    .book-detail .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
        transition: color 0.2s;
    }

    .book-detail .back-link:hover {
        color: #1f2937;
    }

    @media (max-width: 768px) {
        .book-detail .book-layout {
            flex-direction: column;
            /* align-items: center; */
            gap: 1.5rem;
        }

        .book-detail .book-image {
            width: 100%;
            min-width: 100%;
        }

        .book-detail .book-title {
            font-size: 1.5rem;
            /* text-align: center; */
        }

        /* 
        .book-detail .book-subtitle {
            text-align: center;
        } */
        /* 
        .book-detail .book-description {
            text-align: center;
        } */

        .book-detail .buy-buttons {
            justify-content: center;
        }
    }

    @media (max-width: 640px) {
        .book-detail .benefits-grid {
            grid-template-columns: 1fr;
            /* Stacks on mobile */
        }
    }
</style>

<div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <div class="book-detail">

        <!-- Back Link -->
        <a href="/books" class="back-link">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Books
        </a>

        <!-- NEW: Flex container for image + content -->
        <div class="book-layout">
            <!-- Book Image -->
            <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="book-image">

            <!-- Book Content -->
            <div class="book-content">
                <!-- Book Title -->
                <h3 class="book-title"><%= book.title %></h3>
                <% if (book.subtitle) { %>
                <p class="book-subtitle"><i><%= book.subtitle %></i></p>
                <% } %>

                <!-- Book Description -->
                <div class="book-description">
                    <%- book.description %>
                </div>
                <!-- Buy Buttons -->
                <% if (book.buy_buttons && book.buy_buttons.length > 0) { %>
                <div class="buy-buttons">
                    <% book.buy_buttons.forEach(btn => { %>
                    <a href="<%= btn.url %>" target="_blank" rel="noopener noreferrer">
                        <%= btn.label %> <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    </a>
                    <% }) %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Benefits / What's Inside -->
        <% if (book.benefits && book.benefits.length > 0) { %>
        <h2 class="section-title text-center">What's Inside</h2>
        <div class="benefits-grid">
            <% book.benefits.forEach(benefit => { %>
            <div class="benefit-item">
                <div class="benefit-title"><%= benefit.title %></div>
                <div class="benefit-desc"><%= benefit.description %></div>
            </div>
            <% }) %>
        </div>
        <% } %>

        <!-- Table of Contents -->
        <% if (book.table_of_contents && book.table_of_contents.length > 0) { %>
        <div class="max-w-2xl mx-auto"> <!-- Add this wrapper -->
            <h2 class="section-title text-center">Table of Contents</h2>
            <ul class="toc-list">
                <% let number = 1; book.table_of_contents.forEach(chapter => { %>
                <li><span class="font-bold text-green-800"><%= String(number++).padStart(2, '0') %></span> &nbsp &nbsp
                    <%= chapter %></li>
                <% }) %>
            </ul>
        </div> <!-- Close wrapper -->
        <% } %>

        <!-- Medical Note -->
        <% if (book.medical_note) { %>
        <div class="max-w-2xl mx-auto text-center text-gray-500">
            <div class="mt-6 p-4">
                <%- book.medical_note %>
            </div>
        </div>
        <% } %>

        <!-- Newsletter Section -->
        <div class="flex justify-center">
            <div class="max-w-3xl mx-auto px-4 py-8 md:py-12 space-y-16 ">
                <!-- Newsletter Section -->
                <div>
                    <h2 class="section-title text-center">Nora's Notes on Natural Living</h2>
                    <div class="contact-subtitle text-center">
                        Thoughts about good ingredients, simple recipes, and a cleaner kind of life. Sign up for her
                        newsletter,
                        delivered to your inbox.
                    </div>
                    <div class="contact-form-section max-w-md mx-auto text-left">
                        <form action="/newsletter/subscribe" method="POST">
                            <div class="form-group">
                                <label for="name" class="block text-left">Name</label>
                                <input type="text" name="name" required>
                            </div>
                            <div class="form-group">
                                <label for="email" class="block text-left">Email</label>
                                <input type="email" name="email" required>
                            </div>
                            <button type="submit" class="btn-send">Subscribe</button>
                            <span class="text-gray-500 text-xs">We respect your privacy. Unsubscribe at any time.</span>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/public-footer', { settings: settings }) %>