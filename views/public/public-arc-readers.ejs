<%- include('../partials/public-header', { title: settings?.siteTitle || 'Nora Hale Books', settings: settings }) %>

<style>
    .contact-form-section {
        width: 70%;
        max-width: 70%;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 3rem;
        box-shadow: 0 12px 40px rgba(15, 23, 42, .06);
    }

    .notice-section {
        width: 70%;
        max-width: 70%;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 1rem;
        margin: 0 auto;
        background: #ddf9f5;
    }

    .contact-form-section form {
        width: 100%;
    }

    .contact-form-section .form-group {
        margin-bottom: 1.5rem;
    }

    .contact-form-section label {
        display: block;
        margin-bottom: .55rem;
        font-size: .95rem;
        font-weight: 600;
        color: #1f2937;
    }

    .contact-form-section input[type="text"],
    .contact-form-section input[type="email"],
    .contact-form-section textarea {
        width: 100%;
        padding: .95rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        font-size: .95rem;
        color: #111827;
        transition: .2s ease;
    }

    .contact-form-section input::placeholder,
    .contact-form-section textarea::placeholder {
        color: #9ca3af;
    }

    .contact-form-section input:focus,
    .contact-form-section textarea:focus {
        outline: none;
        border-color: #335F55;
        box-shadow: 0 0 0 4px rgba(51, 95, 85, .12);
    }

    .contact-form-section textarea {
        resize: vertical;
        min-height: 140px;
    }

    .btn-send {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: .95rem 2.5rem;
        background: #335F55;
        color: white;
        border: none;
        border-radius: 999px;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
        transition: .25s;
    }

    .btn-send:hover {
        background: #284B43;
        transform: translateY(-1px);
    }

    .btn-send:active {
        transform: translateY(0);
    }

    @media (max-width:768px) {
        .notice-section {
            width: 95%;
            max-width: 95%;
        }

        .contact-form-section {
            width: 95%;
            max-width: 95%;
            /* padding: 2rem 1.5rem; */
            /* border-radius: 14px; */
        }

        .btn-send {
            width: 100%;
        }
    }
</style>

<!-- Header Section -->
<div
    class="w-full h-[50vh] bg-[#C3DFDB] flex flex-col items-center justify-center text-center px-4 sm:px-12 md:px-24 lg:px-32 xl:px-64 2xl:px-64">
    <div class="text-xl sm:text-xl md:text-2xl lg:text-3xl">
        <%- data.title %>
    </div>
    <div class="text-sm sm:text-base md:text-lg mt-2 sm:mt-3 md:mt-4">
        <%- data.message %>
    </div>
</div>

<!-- Form Section -->
<div class="my-4">
    <div class="notice-section max-w-md mx-auto my-2 bg-[#C3DFDB]">
        <div class="text-sm my-4">
            <%- data.howItWorks %>
        </div>
    </div>

    <div class="my-4 flex justify-center items-center min-h-[200px]">
        <div class="contact-form-section max-w-md mx-auto text-left">
            <form action="/newsletter/subscribeARC" method="POST">
                <!-- Name -->
                <div class="form-group">
                    <label for="name" class="block text-left">Name</label>
                    <input type="text" name="name" required>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label for="email" class="block text-left">Email</label>
                    <input type="email" name="email" required>
                </div>

                <!-- Genre Custom Field -->
                <div class="form-group">
                    <label for="genre" class="block text-left">What type of books or genre do you typically
                        read?</label>
                    <input type="text" name="genre">
                </div>

                <!-- Review Platforms Tags (Multiple choices allowed) -->
                <div class="form-group">
                    <label class="block text-left">Where do you post reviews?</label>
                    <div>
                        <label><input type="checkbox" name="review_platforms" value="20016160"> Amazon</label>
                    </div>
                    <div>
                        <label><input type="checkbox" name="review_platforms" value="20016163"> Goodreads</label>
                    </div>
                    <div>
                        <label><input type="checkbox" name="review_platforms" value="20016165"> Booktok/Tiktok</label>
                    </div>
                    <div>
                        <label><input type="checkbox" name="review_platforms" value="20016177"> Bookstagram</label>
                    </div>
                    <div>
                        <label><input type="checkbox" name="review_platforms" value="20016198"> I'm new to
                            reviewing</label>
                    </div>
                </div>

                <!-- Agreement Tag (Required Checkbox) -->
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="agreement" value="20016695" required>
                        I understand I'm agreeing to post an honest review within 4 weeks of receiving my copy
                    </label>
                </div>
                <button type="submit" class="btn-send">Subscribe</button>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/public-footer', { settings: settings }) %>