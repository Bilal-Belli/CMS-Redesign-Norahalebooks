<%- include('../partials/public-header', { title: settings?.siteTitle || 'Nora Hale Books', settings: settings }) %>
<style>
    .contact-form-section {
        max-width: 720px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 3rem;
        box-shadow: 0 12px 40px rgba(15, 23, 42, .06);
    }

    .contact-form-section form {
        width: 100%;
    }

    .contact-form-section .form-group {
        margin-bottom: 1.5rem;
    }

    .contact-form-section label {
        display: block;
        margin-bottom: .55rem;
        font-size: .95rem;
        font-weight: 600;
        color: #1f2937;
    }

    .contact-form-section input[type="text"],
    .contact-form-section input[type="email"],
    .contact-form-section textarea {
        width: 100%;
        padding: .95rem 1rem;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        font-size: .95rem;
        color: #111827;
        transition: .2s ease;
    }

    .contact-form-section input::placeholder,
    .contact-form-section textarea::placeholder {
        color: #9ca3af;
    }

    .contact-form-section input:focus,
    .contact-form-section textarea:focus {
        outline: none;
        border-color: #335F55;
        box-shadow: 0 0 0 4px rgba(51, 95, 85, .12);
    }

    .contact-form-section textarea {
        resize: vertical;
        min-height: 140px;
    }

    .checkbox-group {
        margin: 2rem 0;
    }

    .checkbox-group>label {
        margin-bottom: 1rem;
    }

    .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        margin-bottom: .9rem;
    }

    .checkbox-item input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: #335F55;
        flex-shrink: 0;
    }

    .checkbox-item label {
        margin: 0;
        font-weight: 400;
        line-height: 1.5;
        color: #374151;
        cursor: pointer;
    }

    .form-note {
        font-size: .85rem;
        color: #6b7280;
        margin: -.5rem 0 2rem;
        line-height: 1.5;
    }

    .btn-send {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: .95rem 2.5rem;
        background: #335F55;
        color: white;
        border: none;
        border-radius: 999px;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
        transition: .25s;
    }

    .btn-send:hover {
        background: #284B43;
        transform: translateY(-1px);
    }

    .btn-send:active {
        transform: translateY(0);
    }

    @media (max-width:768px) {
        .contact-form-section {
            padding: 2rem 1.5rem;
            border-radius: 14px;
        }

        .btn-send {
            width: 100%;
        }
    }
</style>

<div
    class="w-full h-[50vh] bg-[#C3DFDB] flex items-center justify-center px-4 sm:px-12 md:px-24 lg:px-32 xl:px-64 2xl:px-64">
    <div class="text-center">
        <%- data.title %>
        <%- data.message %>
    </div>
</div>

<!-- Contact Section -->
<div class="my-16">
    <div class="contact-form-section max-w-md mx-auto px-4 py-4">
        <div class="text-sm my-4">
            <%- data.howItWorks %>
        </div>
        <div class="text-sm my-4"></div>

        <form action="/contact/submit" method="POST">
            <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" required>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" required>
            </div>
            <div class="form-group checkbox-group">
                <label>Where do you post reviews?</label>
                <div class="checkbox-item">
                    <input type="checkbox" name="platforms" value="Amazon" id="amazon">
                    <label for="amazon">Amazon</label>
                </div>
                <div class="checkbox-item">
                    <input type="checkbox" name="platforms" value="Goodreads" id="goodreads">
                    <label for="goodreads">Goodreads</label>
                </div>
                <div class="checkbox-item">
                    <input type="checkbox" name="platforms" value="Booktok/Tiktok" id="booktok">
                    <label for="booktok">Booktok/Tiktok</label>
                </div>
                <div class="checkbox-item">
                    <input type="checkbox" name="platforms" value="Bookstagram" id="bookstagram">
                    <label for="bookstagram">Bookstagram</label>
                </div>
                <div class="checkbox-item">
                    <input type="checkbox" name="platforms" value="I'm new to reviewing" id="new-reviewer">
                    <label for="new-reviewer">I'm new to reviewing</label>
                </div>
            </div>
            <div class="form-group">
                <label>What type of books or genres do you typically read?</label>
                <textarea name="message" placeholder="Fantasy, romance, mystery, historical fiction..."
                    required></textarea>
            </div>
            <div class="form-group checkbox-item">
                <input type="checkbox" name="agree" value="agree" id="agree" required>
                <label for="agree">I understand I'm agreeing to post an honest review within 4 weeks of receiving my
                    copy*</label>
            </div>
            <p class="form-note">
                We respect your privacy. Unsubscribe at any time.
            </p>
            <button type="submit" class="btn-send">Send My Application</button>
        </form>
    </div>
</div>

<%- include('../partials/public-footer', { settings: settings }) %>