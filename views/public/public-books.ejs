<%- include('../partials/public-header', { title: (settings?.siteTitle || 'Nora Hale Books') + ' | Books', settings: settings }) %>

<style>
    .book-row {
        display: flex;
        gap: 2.5rem;
        padding: 2rem 0;
        border-bottom: 1px solid #e5e7eb;
        align-items: flex-start;
    }

    .book-row:last-child {
        border-bottom: none;
    }

    .book-row .book-image {
        width: 50%;
        max-width: 50%;
        aspect-ratio: 3/4;
        background: #f8fafc;
    }

    .book-row .book-content {
        flex: 1;
        padding-top: 0.25rem;
    }

    .book-row .book-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.25rem;
    }

    .book-row .book-subtitle {
        font-size: 1rem;
        color: #4b5563;
        font-weight: 500;
        margin-bottom: 0.75rem;
    }

    .book-row .book-description {
        font-size: 0.9rem;
        color: #6b7280;
        line-height: 1.8;
    }

    .book-row .book-description p {
        margin-bottom: 0.75rem;
    }

    .book-row .book-description p:last-child {
        margin-bottom: 0;
    }

    .book-row .btn-learn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: #059669;
        transition: color 0.2s;
    }

    .book-row .btn-learn:hover {
        color: #065f46;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1.5rem;
    }

    .contact-form-section {
        max-width: 500px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
    }

    .contact-form-section .contact-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .contact-subtitle {
        color: #6b7280;
        margin-bottom: 1.5rem;
        padding-left: 10%;
        padding-right: 10%;
    }

    .contact-form-section form {
        max-width: 500px;
        margin: 0 auto;
    }

    .contact-form-section .form-group {
        margin-bottom: 1rem;
    }

    .contact-form-section input,
    .contact-form-section textarea {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #f8fafc;
    }

    .contact-form-section input:focus,
    .contact-form-section textarea:focus {
        outline: none;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1);
        background: white;
    }

    .contact-form-section textarea {
        min-height: 100px;
        resize: vertical;
    }

    .contact-form-section .btn-send {
        padding: 0.75rem 2.5rem;
        background: #335F55;
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
    }

    .contact-form-section .btn-send:hover {
        background: #284B43;
    }

    .contact-form-section .contact-note {
        margin-top: 1rem;
        font-size: 0.8rem;
        color: #9ca3af;
        letter-spacing: 0.002em;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 1.5rem;
        }

        .contact-form-section {
            padding: 1.5rem;
        }
    }

    @media (max-width: 640px) {
        .book-row {
            flex-direction: column;
            align-items: center;
            /* text-align: center; */
            gap: 1rem;
        }

        .book-row .book-image {
            width: 100%;
            max-width: 100%;
        }

        .book-row .btn-learn {
            justify-content: center;
        }
    }
</style>

<div class="max-w-4xl mx-auto px-4 py-8 md:py-12">

    <!-- Books Header -->
    <div class="mb-8 text-center">
        <h1 class="serif-title text-3xl md:text-4xl font-bold text-gray-900 mb-3">Books</h1>
        <p class="text-gray-500 text-lg">
            A growing library of practical guides for everyday wellness.
        </p>
    </div>

    <!-- Books List -->
    <% if (books && books.length > 0) { %>
    <div class="books-list">
        <% books.forEach(book => { %>
        <div class="book-row">
            <!-- Book Image -->
            <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="book-image">

            <!-- Book Content -->
            <div class="book-content">
                <h2 class="book-title"><%= book.title %></h2>
                <% if (book.subtitle) { %>
                <p class="book-subtitle"><%= book.subtitle %></p>
                <% } %>

                <div class="book-description">
                    <%- book.description %>
                </div>

                <a href="/books/<%= book.slug %>" class="btn-learn">
                    Learn more <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>
        </div>
        <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-16 bg-white border border-gray-100 rounded-xl text-gray-400">
        <i data-lucide="book-open" class="w-12 h-12 mx-auto mb-3 text-gray-300"></i>
        <p class="text-sm">No books published yet. Check back soon!</p>
    </div>
    <% } %>

    <!-- Newsletter Section -->
    <div class="flex justify-center">
        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12 space-y-16 ">
            <!-- Newsletter Section -->
            <div>
                <h2 class="section-title text-center">Nora's Notes on Natural Living</h2>
                <div class="contact-subtitle text-center">
                    Thoughts about good ingredients, simple recipes, and a cleaner kind of life. Sign up for her
                    newsletter,
                    delivered to your inbox.
                </div>
                <div class="contact-form-section max-w-md mx-auto text-left">
                    <form action="/newsletter/subscribe" method="POST">
                        <div class="form-group">
                            <label for="name" class="block text-left">Name</label>
                            <input type="text" name="name" required>
                        </div>
                        <div class="form-group">
                            <label for="email" class="block text-left">Email</label>
                            <input type="email" name="email" required>
                        </div>
                        <button type="submit" class="btn-send">Subscribe</button>
                        <span class="text-gray-500 text-xs">We respect your privacy. Unsubscribe at any time.</span>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/public-footer', { settings: settings }) %>