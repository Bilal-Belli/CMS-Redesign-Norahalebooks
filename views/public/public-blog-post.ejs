<%- include('../partials/public-header', { title: post.title + ' | ' + (settings?.siteTitle || 'Nora Hale Books'), settings: settings }) %>

<div class="max-w-3xl mx-auto px-4 py-8 md:py-12">

    <div class="grid grid-cols-1 gap-8">

        <div>

            <div class="mb-6">
                <a href="/blog"
                    class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-gray-600 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Blog
                </a>
            </div>

            <article class="space-y-6">

                <div class="flex items-center gap-3 text-xs text-gray-400">
                    <span
                        class="category-tag bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full"><%= post.category || 'Uncategorized' %></span>
                    <span><%= post.read_time || '5 min read' %></span>
                    <span>•</span>
                    <span><%= post.formatted_date %></span>
                </div>

                <h1 class="serif-title text-2xl md:text-2xl font-bold text-gray-900 leading-tight">
                    <%= post.title %>
                </h1>

                <div class="blog-content prose prose-emerald max-w-none">
                    <%- post.description %>
                </div>

                <div
                    class="pt-8 mt-8 border-t border-gray-100 flex items-center justify-between gap-4 text-sm text-gray-500">
                    <span class="font-medium text-gray-700">Share this article:</span>
                    <div class="flex items-center gap-2">
                        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(settings?.siteUrl || '') %>/blog/<%= post.slug %>"
                            target="_blank" rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-gray-200 hover:bg-gray-50 hover:text-black transition-colors">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                <path
                                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                            <span class="hidden sm:inline">X</span>
                        </a>

                        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(settings?.siteUrl || '') %>/blog/<%= post.slug %>"
                            target="_blank" rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-gray-200 hover:bg-gray-50 hover:text-blue-600 transition-colors">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                <path
                                    d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
                            </svg>
                            <span class="hidden sm:inline">Facebook</span>
                        </a>
                    </div>
                </div>
            </article>

        </div>

    </div>

</div>

<%- include('../partials/public-footer', { settings: settings }) %>